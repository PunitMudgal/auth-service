{
  "name": "auth-service",
  "scripts": {
    "start": "NODE_ENV=production bun run src/index.ts",
    "dev": "NODE_ENV=development bun run --hot src/index.ts",
    "build": "bun build src/index.ts --outdir dist --target bun",
    "test": "NODE_ENV=test bun test",
    "typecheck": "tsc --noEmit",
    "generate": "NODE_ENV=development drizzle-kit generate",
    "migrate": "NODE_ENV=development drizzle-kit migrate",
    "push": "NODE_ENV=development drizzle-kit push",
    "studio": "NODE_ENV=development drizzle-kit studio",
    "seed": "NODE_ENV=development bun run src/db/seed.ts",
    "unseed": "NODE_ENV=development bun run src/db/unseed.ts"
  },
  "dependencies": {
    "@hono/node-server": "^2.0.12",
    "bcrypt": "^6.0.0",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.12.32",
    "pg": "^8.22.0",
    "pino": "^10.3.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/bun": "latest",
    "@types/node": "^26.1.2",
    "@types/pg": "^8.20.0",
    "@types/pino": "^7.0.5",
    "drizzle-kit": "^0.31.10",
    "pino-pretty": "^13.1.3",
    "typescript": "^7.0.2"
  }
}
